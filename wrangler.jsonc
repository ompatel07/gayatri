{
  // Static-assets-only Worker. There is no "main" script on purpose: this
  // project is PHP, and Cloudflare cannot run PHP. What gets served is the
  // pre-rendered snapshot in netlify-static/, regenerated by
  // tools/build-static.py against the locally running PHP app.
  "name": "gayatri",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./netlify-static",
    "not_found_handling": "404-page"
  }
}
